{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["PortugueseBR", "English"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Laplace",
        "width": 1280,
        "height": 820,
        "minWidth": 440,
        "minHeight": 480,
        "backgroundColor": "#151719",
        "decorations": false,
        "shadow": false
      }
    ]
  }
}
